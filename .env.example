# Dev-server prefix the frontend calls; the Vite proxy strips it before forwarding.
VITE_API_URL=/backend-api

# Where the proxy forwards to — the Express backend (its own default port is 5001).
VITE_API_TARGET=http://localhost:5001

# Set to "enabled" to serve data from MSW instead of the backend.
# Prefer `yarn dev:mock`, which sets this through .env.mock.
VITE_USE_MOCK=disabled
