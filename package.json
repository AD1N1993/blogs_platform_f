{
    "name": "blog-platform-f",
    "version": "0.1.0",
    "private": true,
    "description": "Блог-платформа, фронтенд",
    "license": "UNLICENSED",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "packageManager": "yarn@4.9.1",
    "scripts": {
        "dev": "vite",
        "dev:mock": "vite --mode mock",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "e2e": "playwright test",
        "e2e:open": "playwright test --ui",
        "lint:scripts": "eslint . --max-warnings 0",
        "lint:css": "stylelint \"src/**/*.css\"",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "yarn lint:scripts && yarn lint:css && yarn format:check",
        "lint:fix": "eslint . --fix && yarn lint:css --fix && yarn format",
        "api:schema": "node scripts/sync-api-schema.mjs",
        "api:types": "openapi-typescript src/types/generated/openapi.json -o src/types/generated/api.ts && prettier --write src/types/generated/api.ts",
        "api:sync": "yarn api:schema && yarn api:types",
        "find-deadcode": "knip",
        "prepare": "husky"
    },
    "dependencies": {
        "@reduxjs/toolkit": "2.9.0",
        "@tanstack/react-query": "5.90.2",
        "axios": "1.19.0",
        "classnames": "2.5.1",
        "date-fns": "4.1.0",
        "react": "19.1.1",
        "react-dom": "19.1.1",
        "react-redux": "9.2.0",
        "react-router-dom": "7.18.2"
    },
    "devDependencies": {
        "@commitlint/cli": "19.8.1",
        "@commitlint/config-conventional": "19.8.1",
        "@eslint/js": "9.39.1",
        "@playwright/test": "1.55.1",
        "@tanstack/react-query-devtools": "5.90.2",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.0",
        "@testing-library/user-event": "14.6.1",
        "@types/node": "22.18.6",
        "@types/react": "19.1.13",
        "@types/react-dom": "19.1.9",
        "@vitejs/plugin-react": "6.0.4",
        "@vitest/coverage-v8": "4.1.10",
        "eslint": "9.39.1",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "4.4.4",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.4.20",
        "globals": "16.4.0",
        "husky": "9.1.7",
        "jsdom": "26.1.0",
        "knip": "5.64.1",
        "lint-staged": "16.2.3",
        "msw": "2.11.3",
        "openapi-typescript": "^7.13.0",
        "prettier": "3.6.2",
        "stylelint": "16.24.0",
        "stylelint-config-standard": "39.0.0",
        "typescript": "5.9.2",
        "typescript-eslint": "8.65.0",
        "vite": "8.1.5",
        "vitest": "4.1.10"
    },
    "msw": {
        "workerDirectory": [
            "public"
        ]
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix --max-warnings 0",
            "prettier --write"
        ],
        "*.css": [
            "stylelint --fix",
            "prettier --write"
        ],
        "*.{json,md,yaml,yml}": [
            "prettier --write"
        ]
    }
}
